# Leave unset to use data/tutorflow.db (SQLite) for immediate local development.
# PostgreSQL: create an empty tutorflow database and a dedicated login first.
# URL-encode special characters in the password (e.g. @ becomes %40).
# DATABASE_URL=postgresql+psycopg://tutorflow:CHANGE_ME@127.0.0.1:5432/tutorflow

IMAGE_PROVIDER_MODE=remote

# Required when scripts/start-shared.ps1 starts PUBLIC_SHARE_MODE=true.
SHARE_USERNAME=tutorflow
SHARE_PASSWORD=
# Use a randomly generated password with at least 16 characters; keep .env private.
PUBLIC_SHARE_MODE=false
# FRONTEND_DIST_DIR=C:/path/to/tutorflow/dist
# FRONTEND_PROJECT_DIR=/path/to/tutorflow
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
